{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProductsCatalog",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:191918535218:table/ProductsCatalog",
        "arn:aws:dynamodb:ap-south-1:191918535218:table/ProductsCatalog/index/*"
      ]
    },
    {
      "Sid": "WriteEvaluations",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:191918535218:table/Evaluations"
    },
    {
      "Sid": "InvokeBedrock",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.nova-*",
        "arn:aws:bedrock:*:191918535218:inference-profile/apac.amazon.nova-*"
      ]
    },
    {
      "Sid": "ReadPhotosFromS3",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::amazeloop-*/*"
    }
  ]
}
