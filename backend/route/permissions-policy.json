{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EvaluationsReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:191918535218:table/Evaluations"
    },
    {
      "Sid": "InvokeBedrock",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.nova-*",
        "arn:aws:bedrock:*:191918535218:inference-profile/apac.amazon.nova-*"
      ]
    }
  ]
}
